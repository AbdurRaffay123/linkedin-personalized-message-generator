# Copy to .env and fill in. All keys optional — the mock provider needs none,
# so the full pipeline runs end-to-end without any secrets.

ENVIRONMENT=development
DEBUG=true

# --- Database ---
# Local dev default (SQLite):
DATABASE_URL=sqlite:///./ai_sales_assistant.db
#
# Supabase Postgres (project: ai-sales-assistant, ref: aziirmtstayrnjdnlpxw).
# Get the password from Supabase dashboard → Project Settings → Database
# (reset it there if unknown), then use ONE of:
#
#   Direct (persistent server):
#   DATABASE_URL=postgresql+psycopg://postgres:[PASSWORD]@db.aziirmtstayrnjdnlpxw.supabase.co:5432/postgres
#
#   Transaction pooler (serverless / many short connections; port 6543):
#   DATABASE_URL=postgresql+psycopg://postgres.aziirmtstayrnjdnlpxw:[PASSWORD]@aws-0-eu-west-2.pooler.supabase.com:6543/postgres
#
# Schema is already applied on Supabase (Alembic head 5d4c98978c63). The backend
# connects with the privileged postgres role, which bypasses RLS by design.

# --- LLM provider keys ---
# FREE, no credit card:
#   GEMINI_API_KEY   → https://aistudio.google.com/apikey   (recommended)
#   GROQ_API_KEY     → https://console.groq.com             (fast, Llama 3.3 70B)
#   OPENROUTER_API_KEY → https://openrouter.ai              (use :free models)
#   Ollama (local)   → install https://ollama.com, no key needed
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
# Generic OpenAI-compatible endpoint (LM Studio, self-hosted):
OPENAI_BASE_URL=
OPENAI_API_KEY=

# --- Role -> model routing (provider:model). Defaults use the keyless mock. ---
# FREE setups — pick one and uncomment:
#
# Gemini (free tier, recommended):
#   MODEL_EXTRACTION=gemini:gemini-2.0-flash-lite
#   MODEL_REASONING=gemini:gemini-2.0-flash
#   MODEL_MESSAGE_GEN=gemini:gemini-2.0-flash
#
# Groq (free tier):
#   MODEL_EXTRACTION=groq:llama-3.1-8b-instant
#   MODEL_REASONING=groq:llama-3.3-70b-versatile
#   MODEL_MESSAGE_GEN=groq:llama-3.3-70b-versatile
#
# Ollama (fully local, free forever — after `ollama pull qwen2.5:7b`):
#   MODEL_EXTRACTION=ollama:qwen2.5:7b
#   MODEL_REASONING=ollama:qwen2.5:7b
#   MODEL_MESSAGE_GEN=ollama:qwen2.5:7b
#
# Paid (if you ever upgrade): anthropic:claude-sonnet-5 for message gen.
MODEL_EXTRACTION=mock:extraction
MODEL_REASONING=mock:reasoning
MODEL_MESSAGE_GEN=mock:message

# --- Research (Phase 2) ---
EXA_API_KEY=

# --- Retention (GDPR/CCPA) ---
DATA_RETENTION_DAYS=90
# Purge expired prospects on a schedule: `python -m app.purge` (cron daily).

# --- Auth ---
# Keep true everywhere except throwaway local experiments. Issue keys with:
#   python -m app.issue_key you@example.com "my key"
AUTH_REQUIRED=true

# --- Rate limits (per user per hour; in-process — use Redis for multi-worker) ---
RATE_LIMIT_ANALYZE_PER_HOUR=60
RATE_LIMIT_CAPTURE_PER_HOUR=300

# --- CORS: JSON list of allowed origins (used when DEBUG=false) ---
CORS_ORIGINS=["http://localhost:3000"]
